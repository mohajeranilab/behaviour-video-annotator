# Label Studio API key (get from Account & Settings in Label Studio UI)
LABEL_STUDIO_API_KEY=your_api_key_here

# Polling interval in seconds (how often the backend checks for completed annotations)
POLL_INTERVAL_SEC=30

# Number of total clips per wave
CLIPS_PER_WAVE=20

# Number of predicted-sleeping clips per wave (remainder are predicted-awake)
SLEEP_CLIPS_PER_WAVE=3

# Optional: path to DayNightConfig JSON (inside the container, e.g. /app/state/config.json)
CONFIG_PATH=
